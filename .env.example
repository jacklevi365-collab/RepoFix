# Export these variables in your terminal. .env is not loaded automatically.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# REQUIRED for live calls: current RMB price per million tokens from your account.
# Use uncached input pricing; cache discounts are deliberately not assumed.
REPOFIX_INPUT_RMB_PER_MILLION=
REPOFIX_OUTPUT_RMB_PER_MILLION=
